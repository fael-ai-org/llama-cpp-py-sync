+// Callbacks transfer exactly size bytes or return false. The caller supplies
+// an authorized stream and keeps its context alive until native use ends.
+// No sockets or transport upgrades are opened for caller-owned streams.
+typedef struct ggml_rpc_stream {
+    void * user_data;
+    bool (*send)(void * user_data, const void * data, size_t size);
+    bool (*recv)(void * user_data, void * data, size_t size);
+    void (*close)(void * user_data);
+} ggml_rpc_stream;
+
+GGML_BACKEND_API ggml_backend_reg_t ggml_backend_rpc_add_stream(const char * name, const ggml_rpc_stream * stream);
+// Release only after all models, buffers and backend users have stopped.
+GGML_BACKEND_API bool ggml_backend_rpc_remove_stream(const char * name);
+GGML_BACKEND_API bool ggml_backend_rpc_serve_stream(const ggml_rpc_stream * stream,
+    const char * cache_dir, size_t n_threads, size_t n_devices, ggml_backend_dev_t * devices);
+
 // backend API
 GGML_BACKEND_API ggml_backend_t ggml_backend_rpc_init(const char * endpoint, uint32_t device);
 GGML_BACKEND_API bool ggml_backend_is_rpc(ggml_backend_t backend);
