include LICENSE
include README.md
include THIRD_PARTY_NOTICES.txt
include pyproject.toml

recursive-include src *.py *.pyi *.so *.so.* *.dylib *.dll py.typed
recursive-include scripts *.py

prune vendor
prune .github
prune examples
prune tests
prune __pycache__
prune *.egg-info

global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
