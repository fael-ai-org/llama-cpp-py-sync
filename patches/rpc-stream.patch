         thread.join();
     }
+    sock = nullptr;
 }
 
+static std::mutex stream_mutex;
+static std::unordered_map<std::string, std::shared_ptr<rpc_dispatcher>> stream_dispatchers;
+static std::unordered_set<std::string> stream_names;
+
 static std::shared_ptr<rpc_dispatcher> get_dispatcher(const std::string & endpoint) {
+    if (endpoint.compare(0, 7, "stream:") == 0) {
+        std::lock_guard<std::mutex> lock(stream_mutex);
+        auto it = stream_dispatchers.find(endpoint);
+        if (it == stream_dispatchers.end()) GGML_ABORT("RPC stream is unavailable\n");
+        return it->second;
+    }
     static std::mutex mutex;
     std::lock_guard<std::mutex> lock(mutex);
     static std::unordered_map<std::string, std::weak_ptr<rpc_dispatcher>> dispatchers;
@@ -2158,6 +2172,26 @@ void ggml_backend_rpc_start_server(const char * endpoint, const char * cache_dir
     }
 }
 
+bool ggml_backend_rpc_serve_stream(const ggml_rpc_stream * stream, const char * cache_dir,
+                                  size_t n_threads, size_t n_devices, ggml_backend_dev_t * devices) {
+    auto sock = socket_t::from_stream(stream);
+    if (!sock || !devices || !n_devices || !n_threads) return false;
+    std::vector<ggml_backend_t> backends;
+    bool initialized = true;
+    for (size_t i = 0; i < n_devices; ++i) {
+        auto dev = devices[i];
+        auto backend = dev ? ggml_backend_dev_init(dev, nullptr) : nullptr;
+        if (!backend) { initialized = false; break; }
+        backends.push_back(backend);
+        auto reg = ggml_backend_dev_backend_reg(dev);
+        auto set_threads = (ggml_backend_set_n_threads_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+        if (set_threads) set_threads(backend, n_threads);
+    }
+    if (initialized) rpc_serve_client(backends, cache_dir, sock);
+    for (auto backend : backends) ggml_backend_free(backend);
+    return initialized;
+}
+
 static const char * ggml_backend_rpc_device_get_name(ggml_backend_dev_t dev) {
     ggml_backend_rpc_device_context * ctx = (ggml_backend_rpc_device_context *)dev->context;
 
@@ -2379,3 +2413,38 @@ ggml_backend_reg_t ggml_backend_rpc_add_server(const char * endpoint) {
 
 
 GGML_BACKEND_DL_IMPL(ggml_backend_rpc_reg)
+
+ggml_backend_reg_t ggml_backend_rpc_add_stream(const char * name, const ggml_rpc_stream * stream) {
+    if (!name || !*name || std::strlen(name) > 128) return nullptr;
+    auto sock = socket_t::from_stream(stream);
+    if (!sock) return nullptr;
+    std::string endpoint = "stream:" + std::string(name);
+    {
+        std::lock_guard<std::mutex> lock(stream_mutex);
+        if (!stream_names.insert(endpoint).second) return nullptr;
+    }
+    auto dispatcher = std::make_shared<rpc_dispatcher>();
+    dispatcher->start(endpoint, sock);
+    {
+        std::lock_guard<std::mutex> lock(stream_mutex);
+        stream_dispatchers.emplace(endpoint, dispatcher);
+    }
+    auto registration = ggml_backend_rpc_add_server(endpoint.c_str());
+    if (!registration) ggml_backend_rpc_remove_stream(name);
+    return registration;
+}
+
+bool ggml_backend_rpc_remove_stream(const char * name) {
+    if (!name) return false;
+    std::shared_ptr<rpc_dispatcher> dispatcher;
+    {
+        std::lock_guard<std::mutex> lock(stream_mutex);
+        auto it = stream_dispatchers.find("stream:" + std::string(name));
+        if (it == stream_dispatchers.end()) return true;
+        if (it->second.use_count() != 1) return false;
+        dispatcher = std::move(it->second);
+        stream_dispatchers.erase(it);
+    }
+    // Destruction and callbacks must not run while holding the registry lock.
+    return true;
+}
